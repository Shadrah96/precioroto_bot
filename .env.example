# Copia este fichero a .env y rellena los dos primeros valores.
# En GitHub, estos van en Settings > Secrets and variables > Actions > New repository secret.

TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# Tiendas que cubre este runner. Sin definir = todas.
# Solo hace falta si repartes el trabajo entre tu PC y GitHub Actions.
# STORES=amazon,pccomponentes,carrefour

# --- Ajuste fino de la deteccion (opcional, todos tienen valor por defecto) ---

# Dias de historico que se guardan por producto
# HISTORY_DAYS=90
# Ventana usada para calcular el precio "normal" (mediana)
# WINDOW_DAYS=60

# Muestras minimas antes de fiarse del historico
# MIN_SAMPLES=6
# Horas minimas de historico antes de fiarse
# MIN_SPAN_HOURS=12

# precio_actual / precio_normal por debajo de esto => "ERROR DE PRECIO" (0.20 = 80% dto)
# RATIO_ERROR=0.20
# ...por debajo de esto => "chollo serio" (0.40 = 60% dto)
# RATIO_DEAL=0.40
# Caida brusca respecto a la ultima lectura que dispara aviso aunque haya poco historico
# CRASH_RATIO=0.25

# Ahorro absoluto minimo en euros para molestarte
# MIN_ABS_DROP=10

# Horas de silencio tras avisar del mismo producto
# COOLDOWN_HOURS=24
# ...salvo que el precio baje otro X% adicional
# REALERT_DROP=0.10

# Segundos de espera entre peticiones a la MISMA tienda (baja = mas riesgo de bloqueo)
# REQUEST_DELAY_MS=2500
# TIMEOUT_MS=20000
# MAX_RETRIES=3
